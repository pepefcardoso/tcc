# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/wearable_dev
PG_POOL_MAX=10

# Auth
JWT_USER_SECRET=change-me-32-char-minimum-secret
JWT_USER_EXPIRES_IN=8h
JWT_DEVICE_SECRET=change-me-different-32-char-secret
JWT_DEVICE_EXPIRES_IN=3650d

# Upload
UPLOAD_MAX_FILE_SIZE_MB=100
UPLOAD_TMP_DIR=/tmp/uploads

# Processing
GPS_BATCH_INSERT_SIZE=500
IMU_BATCH_INSERT_SIZE=1000
