# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=app_user
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
POSTGRES_DB=wearable_prod
# Important: Ensure DATABASE_URL matches the credentials defined above.
DATABASE_URL=postgresql://app_user:CHANGE_ME_strong_random_password@postgres:5432/wearable_prod
PG_POOL_MAX=10

# ─── Auth (must be >=32 random chars each, must differ from each other) ────────
JWT_USER_SECRET=CHANGE_ME_at_least_32_random_chars
JWT_USER_EXPIRES_IN=8h
JWT_DEVICE_SECRET=CHANGE_ME_different_at_least_32_random_chars
JWT_DEVICE_EXPIRES_IN=3650d

# ─── Upload ───────────────────────────────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE_MB=100
UPLOAD_TMP_DIR=/tmp/uploads

# ─── Processing ───────────────────────────────────────────────────────────────
GPS_BATCH_INSERT_SIZE=500
IMU_BATCH_INSERT_SIZE=1000

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_UPLOAD_WINDOW_MS=900000
RATE_LIMIT_UPLOAD_MAX=30

# ─── Security / CORS ──────────────────────────────────────────────────────────
# Set to the public HTTPS URL of the frontend in real prod
CORS_ALLOWED_ORIGIN=http://localhost:8080
